{
  "name": "@mykeura/dsh-minimalist-themes",
  "description": "Minimalist Themes plugin: adapts the Minimalist theme collection palettes to the DSH --dsw-* token system and adds a picker card under Settings > Plugins",
  "version": "1.0.1",
  "author": "mykeura",
  "license": "MIT",
  "homepage": "https://github.com/mykeura/dsh-minimalist-themes#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mykeura/dsh-minimalist-themes"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "minimalist",
    "color-palette"
  ],
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "external": []
    }
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/react": "18.3.31",
    "clsx": "^2.1.1",
    "lightningcss": "^1.33.0",
    "react": "18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
